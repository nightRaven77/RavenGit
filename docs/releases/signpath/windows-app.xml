<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración estable: el ejecutable debe estar finalizado antes de solicitar su firma. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="ravengit.exe" product-name="RavenGit" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
