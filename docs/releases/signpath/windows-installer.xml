<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración estable: firma únicamente el instalador exterior, no su contenido NSIS. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="RavenGit_${version}_x64-setup.exe" product-name="RavenGit" product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
