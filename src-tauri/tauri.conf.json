{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RavenGit",
  "version": "1.0.6",
  "identifier": "dev.ravengit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RavenGit · Historial y publicación",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Development",
    "shortDescription": "Cliente Git visual y local-first",
    "longDescription": "Cliente Git de escritorio moderno, visual y local-first construido con Tauri 2, React y Rust.",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "git"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
